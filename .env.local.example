# Detección de referencias bíblicas por voz (modo IA) — Groq
# Obtén tu clave en: https://console.groq.com/keys (ultra-rápido y económico)
GROQ_API_KEY=tu_groq_api_key_aqui

# Opcional: token de la API de cantaricrestine.ro para refrescar el catálogo
# de cânturi en vivo (por defecto usa el token público '123' si se omite).
CANTARI_TOKEN=

# INSTRUCCIONES:
# 1. Copia este archivo como .env.local en la raíz del proyecto (Next.js lo
#    carga automáticamente; no requiere dotenv).
# 2. Reemplaza GROQ_API_KEY con tu clave real.
# 3. .env.local NO debe subirse a git (ya está en .gitignore).
